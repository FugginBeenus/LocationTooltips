{
  "schemaVersion": 1,
  "id": "locationtooltip",
  "version": "${version}",
  "name": "Location Tooltip",
  "description": "Shows the name of wherever you are standing. Draw your own regions, lock down what people can do inside them, and let villages name themselves.",
  "authors": ["fugginbeenus"],
  "contact": {
    "homepage": "https://modrinth.com/mod/location-tooltip",
    "sources": "https://github.com/FugginBeenus/LocationTooltips",
    "issues": "https://github.com/FugginBeenus/LocationTooltips/issues"
  },
  "license": "MIT",
  "icon": "assets/locationtooltip/icon.png",
  "environment": "*",
  "entrypoints": {
    "main":   ["com.fugginbeenus.locationtooltip.LocationTooltip"],
    "client": ["com.fugginbeenus.locationtooltip.LocationTooltipClient"],
    "modmenu": ["com.fugginbeenus.locationtooltip.config.ui.LocationTooltipModMenu"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_dep}",
    "fabric-api": "*"
  },
  "suggests": {
    "cloth-config2": "*",
    "modmenu": "*",
    "waystones": "*"
  },
  "mixins": [
    "locationtooltip.mixins.json"
  ]
}